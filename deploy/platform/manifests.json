    {
      "apiVersion": "apps/v1",
      "kind": "Deployment",
      "metadata": {
        "name": "pritunl",
        "namespace": "pritunl"
      },
      "spec": {
        "replicas": 1,
        "strategy": {
          "type": "Recreate"
        },
        "selector": {
          "matchLabels": {
            "app": "pritunl"
          }
        },
        "template": {
          "metadata": {
            "labels": {
              "app": "pritunl"
            }
          },
          "spec": {
            "automountServiceAccountToken": false,
            "terminationGracePeriodSeconds": 120,
            "containers": [
              {
                "name": "mongodb",
                "image": "mongo:8.0",
                "args": [
                  "--bind_ip",
                  "127.0.0.1",
                  "--wiredTigerCacheSizeGB",
                  "0.25"
                ],
                "resources": {
                  "requests": {
                    "cpu": "100m",
                    "memory": "256Mi"
                  },
                  "limits": {
                    "cpu": "2",
                    "memory": "768Mi"
                  }
                },
                "volumeMounts": [
                  {
                    "name": "storage",
                    "mountPath": "/data/db",
                    "subPath": "mongodb"
                  }
                ]
              },
              {
                "name": "pritunl",
                "image": "ghcr.io/jippi/docker-pritunl:latest-minimal@sha256:f588e4fb3d5e335f5d5a03699188ed6ebdca1cdf0ab182a9a880c67d3a24d3c0",
                "env": [
                  {
                    "name": "PRITUNL_MONGODB_URI",
                    "value": "mongodb://127.0.0.1:27017/pritunl"
                  }
                ],
                "securityContext": {
                  "privileged": true
                },
                "ports": [
                  {
                    "name": "https",
                    "containerPort": 443
                  },
                  {
                    "name": "vpn",
                    "containerPort": 1194,
                    "protocol": "UDP"
                  }
                ],
                "resources": {
                  "requests": {
                    "cpu": "100m",
                    "memory": "256Mi"
                  },
                  "limits": {
                    "cpu": "2",
                    "memory": "1Gi"
                  }
                },
                "startupProbe": {
                  "tcpSocket": {
                    "port": 443
                  },
                  "periodSeconds": 10,
                  "failureThreshold": 60
                },
                "readinessProbe": {
                  "httpGet": {
                    "path": "/",
                    "port": 443,
                    "scheme": "HTTPS"
                  },
                  "periodSeconds": 10,
                  "timeoutSeconds": 5
                },
                "volumeMounts": [
                  {
                    "name": "storage",
                    "mountPath": "/var/lib/pritunl",
                    "subPath": "pritunl"
                  },
                  {
                    "name": "tun",
                    "mountPath": "/dev/net/tun"
                  },
                  {
                    "name": "storage",
                    "mountPath": "/packages",
                    "subPath": "packages",
                    "readOnly": true
                  }
                ],
                "command": [
                  "bash",
                  "-ec"
                ],
                "args": [
                  "dpkg -i '/packages/pritunl_1.34.4763.45-0ubuntu1~focal_amd64.deb'; exec /bin/start-pritunl"
                ]
              }
            ],
            "volumes": [
              {
                "name": "storage",
                "persistentVolumeClaim": {
                  "claimName": "pritunl-data"
                }
              },
              {
                "name": "tun",
                "hostPath": {
                  "path": "/dev/net/tun",
                  "type": "CharDevice"
                }
              }
            ],
            "initContainers": [
              {
                "name": "fetch-current-pritunl",
                "image": "ghcr.io/jippi/docker-pritunl:latest-minimal@sha256:f588e4fb3d5e335f5d5a03699188ed6ebdca1cdf0ab182a9a880c67d3a24d3c0",
                "command": [
                  "bash",
                  "-ec"
                ],
                "args": [
                  "cd /packages\nif [ ! -f 'pritunl_1.34.4763.45-0ubuntu1~focal_amd64.deb' ]; then\n  apt-get update -qq\n  apt-get download 'pritunl=1.34.4763.45-0ubuntu1~focal'\nfi\necho 'e36d8f5d68681ef6c677380eeeac5439ebec64bd7eb888de219537456433c929  pritunl_1.34.4763.45-0ubuntu1~focal_amd64.deb' | sha256sum -c -"
                ],
                "resources": {
                  "requests": {
                    "cpu": "100m",
                    "memory": "128Mi"
                  },
                  "limits": {
                    "cpu": "2",
                    "memory": "512Mi"
                  }
                },
                "volumeMounts": [
                  {
                    "name": "storage",
                    "mountPath": "/packages",
                    "subPath": "packages"
                  }
                ]
              }
            ]
          }
        }
      }
